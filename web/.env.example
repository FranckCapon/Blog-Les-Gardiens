# Copier ce fichier en .env.local puis adapter les valeurs.

# Base PostgreSQL locale lancée par `npm run db:up`.
DATABASE_URL=postgres://gardiens:gardiens@localhost:5432/gardiens

# Better Auth : secret d'au moins 32 caractères (générer avec `openssl rand -base64 32`)
# et URL publique du site.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Envoi des e-mails (vérification d'adresse, mot de passe oublié).
# Sans SMTP_URL, les e-mails sont affichés dans la console du serveur.
# SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.fr:465
EMAIL_FROM="Les Gardiens de la Légende <no-reply@lesgardiensdelalegende.fr>"
